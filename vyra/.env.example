# PostgreSQL
POSTGRES_USER=vyra
POSTGRES_PASSWORD=vyra_secret
POSTGRES_DB=vyra_db

# MongoDB
MONGO_USER=vyra
MONGO_PASSWORD=vyra_secret
MONGO_DB=vyra_logs

# Redis (sem autenticação no dev)
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=troque_por_uma_string_longa_e_aleatoria_aqui
JWT_REFRESH_SECRET=outro_secret_diferente_para_refresh_token

# Google Gemini
GEMINI_API_KEY=sua_chave_aqui

# SMTP (ex: Gmail, Mailtrap para dev)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=seu_usuario
SMTP_PASS=sua_senha
SMTP_FROM="Vyra CRM <seuemail@gmail.com>"

# App
PORT=3000
NODE_ENV=development

# Webhook de leads 
WEBHOOK_SECRET=troque-por-um-valor-gerado

# Origens do frontend autorizadas a chamar a API com cookies (separadas por vírgula)
CORS_ORIGIN=http://localhost:3100,http://localhost:3001

# Produção: endereço do site (ex.: 191-2-3-4.sslip.io). Usado pelo Caddy (HTTPS),
# pelo CORS e pelo link do e-mail de recuperação de senha.
DOMINIO=seu-ip-com-tracos.sslip.io
